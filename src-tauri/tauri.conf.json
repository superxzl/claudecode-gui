{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Desk",
  "version": "0.1.0",
  "identifier": "dev.claudedesk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Claude Desk",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "devtools": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local GUI for Claude Code CLI"
  }
}
